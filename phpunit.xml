<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>
    <php>
        <!--
            Feature tests need a Redis they may FLUSHDB, so point these at a
            throwaway server. See the README for a one-line docker command.
            Tests skip themselves when nothing answers.
        -->
        <env name="REDIS_HOST" value="127.0.0.1"/>
        <env name="REDIS_PORT" value="63799"/>
        <env name="REDIS_PASSWORD" value=""/>
        <env name="REDIS_QUEUE_DB" value="15"/>
    </php>
</phpunit>
